# ===== 基础 =====
APP_NAME=AI 园艺医生
APP_ENV=dev
DEBUG=true
SECRET_KEY=dev-only-secret-change-me-before-production
API_V1_PREFIX=/api/v1

# ===== 数据库（MySQL 8+）=====
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/gardening_doctor?charset=utf8mb4
DB_ECHO=false

# ===== 微信小程序 =====
# 没有 AppID 时留空，本地用 mock_ 前缀的 code 登录（见 WECHAT_MOCK_LOGIN）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK_LOGIN=true

# ===== 大模型 =====
# stub=假模型（无需 Key）；qwen=通义千问 VL；doubao=豆包 Vision（model 填推理接入点 ID）
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
# 留空则用厂商默认端点：qwen=dashscope compatible-mode，doubao=ark
LLM_BASE_URL=
LLM_TIMEOUT=15

# ===== 业务阈值 =====
MAX_IMAGES_PER_REQUEST=3
MAX_IMAGE_SIZE_MB=2
DAILY_FREE_QUOTA=10
USER_TOKEN_EXPIRE_DAYS=7
ADMIN_TOKEN_EXPIRE_HOURS=12

# ===== 限流与成本熔断（T3.3）=====
# 每用户每分钟请求数 + 全局每秒请求数，超了统一返回 3002 / 429 且不扣额度
RATE_LIMIT_USER_PER_MINUTE=6
RATE_LIMIT_GLOBAL_QPS=10
# 成本折算：今日累计 token × 单价 / 1000；到上限直接熔断，避免 Key 配错时费用失控
LLM_PRICE_PER_1K_TOKENS=0.02
DAILY_COST_LIMIT_CNY=50

# ===== 后台账号（仅 scripts/seed_admin.py 读取）=====
# 执行 python -m scripts.seed_admin 初始化；服务启动不会自动建号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production

# ===== 存储与跨域 =====
# 相对路径按 backend/ 解析；没有域名期间图片由后端静态目录返回：/static/年/月/xxx.jpg
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/static
STATIC_MOUNT_PATH=/static
# 小程序不受 CORS 限制，留空即可；后台管理页调试可填 http://localhost:5173
CORS_ORIGINS=
