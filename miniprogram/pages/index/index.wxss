/* 首页：顶部问候 → 额度面板 → 拍照主操作 → 入口 → 科普，自上而下一条动线 */

/* ---------- 顶部问候条 ---------- */
.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.home-greet {
  flex: 1;
  overflow: hidden;
}

.home-hi {
  font-size: var(--t-h1);
  font-weight: 600;
  letter-spacing: 0.2rpx;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.home-sub {
  margin-top: 6rpx;
  font-size: var(--t-cap);
  color: var(--ink-3);
}

/* 头像：沿用个人中心那套外圈细环 + 轻投影，保证两处观感一致。
   外层留 8rpx 内边距把点击区撑到 104rpx，再用负外边距让头像右缘与页面留白对齐 */
.home-avatar-hit {
  flex: 0 0 auto;
  padding: 8rpx;
  margin: -8rpx -8rpx -8rpx 0;
  border-radius: 50%;
  transition: transform 160ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 160ms ease;
}

.home-avatar {
  display: block;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  border: 2rpx solid rgba(46, 125, 70, 0.14);
  box-shadow: 0 8rpx 20rpx rgba(23, 53, 33, 0.08);
}

/* ---------- 图片选择区 ---------- */
.picked-list {
  display: flex;
  flex-wrap: wrap;
  margin: 28rpx 0 4rpx;
}

.picked-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 20rpx 20rpx 0;
}

.picked-thumb {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: var(--r-md);
  background: var(--brand-tint);
}

.picked-remove {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(23, 35, 26, 0.62);
  color: #ffffff;
  font-size: 30rpx;
  transition: transform 160ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 160ms ease;
}

/* ---------- 作物提示输入 ---------- */
.hint-input {
  margin: 24rpx 0 0;
  padding: 22rpx 28rpx;
  background: var(--canvas);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  font-size: var(--t-sm);
  color: var(--ink);
  transition: border-color 200ms ease, background-color 200ms ease;
}

.hint-placeholder {
  color: var(--ink-4);
}

/* ---------- 主操作 + 次操作 ---------- */
.capture-btn {
  width: 100%;
  margin-top: 28rpx;
}

.choose-row {
  display: flex;
  margin-top: 20rpx;
}

.choose-btn {
  flex: 1;
}

.choose-btn + .choose-btn {
  margin-left: 20rpx;
}

/* ---------- 入口列表 ---------- */
.menu-card {
  padding: 8rpx 32rpx;
}

/* ---------- 科普轮播 ---------- */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-head .card-title {
  margin-bottom: 0;
}

/* 「自动轮播」只是一个弱提示，不抢标题层级 */
.section-mark {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-size: var(--t-micro);
  letter-spacing: 1rpx;
  color: var(--ink-4);
}

.disease-swiper {
  height: 320rpx;
}

.disease-slide {
  display: flex;
  align-items: flex-start;
  height: 100%;
  /* 底部留白给原生指示点，避免压住「查看详情」 */
  padding: 4rpx 0 40rpx;
  box-sizing: border-box;
}

/* 图片缺失时的兜底：低饱和绿底 + 一枚淡叶形，保证没有照片也不空荡 */
.disease-media {
  position: relative;
  flex: 0 0 216rpx;
  width: 216rpx;
  height: 216rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--brand-tint);
}

.disease-media-fallback {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: var(--brand-tint);
}

.disease-media-fallback::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 86rpx;
  height: 110rpx;
  margin: -55rpx 0 0 -43rpx;
  border-radius: 60% 0 60% 0;
  background: rgba(46, 125, 70, 0.14);
  transform: rotate(-18deg);
}

.disease-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.disease-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding-top: 2rpx;
}

.disease-head {
  display: flex;
  align-items: center;
}

.disease-name {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.disease-head .chip {
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.disease-symptom {
  margin-top: 10rpx;
  font-size: var(--t-cap);
  line-height: 1.55;
  color: var(--ink-3);
  /* 轮播卡高度固定，症状最多两行，超出省略避免撑破版式 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.disease-more {
  margin-top: 16rpx;
  font-size: var(--t-micro);
  font-weight: 500;
  letter-spacing: 0.4rpx;
  color: var(--brand);
}

/* 科普列表加载态：两条骨架线代替干巴巴的「加载中…」 */
.disease-loading {
  padding-bottom: 12rpx;
}

/* ---------- 隐私授权弹窗 ---------- */
.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 0 48rpx;
  background: rgba(18, 30, 21, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

/* 弹窗从下方轻微上浮并放大就位，比直接出现更有分量 */
.privacy-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 36rpx 32rpx;
  background: var(--paper);
  border-radius: 32rpx;
  box-shadow: 0 24rpx 60rpx rgba(18, 30, 21, 0.18);
  animation: dialogIn 340ms cubic-bezier(0.34, 1.35, 0.5, 1) both;
}

.privacy-title {
  font-size: var(--t-h2);
  font-weight: 600;
  text-align: center;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.privacy-dialog .muted {
  line-height: 1.7;
}

.privacy-link {
  margin: 24rpx 0 4rpx;
  font-size: var(--t-sm);
  font-weight: 500;
  color: var(--brand);
  transition: opacity 160ms ease;
}

.privacy-actions {
  display: flex;
  margin-top: 28rpx;
}

.privacy-actions .btn-secondary,
.privacy-actions .btn-primary {
  height: 84rpx;
  line-height: 84rpx;
  font-size: var(--t-sm);
  padding: 0 24rpx;
}

.privacy-reject {
  flex: 1;
}

.privacy-agree {
  flex: 1.3;
  margin-left: 20rpx;
}
