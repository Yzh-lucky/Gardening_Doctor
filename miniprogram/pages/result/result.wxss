/* 识别结果：先给结论，再给依据，最后给方案；三档方案用统一标签区分 */

/* ---------- 失败态 ---------- */
.fail-card {
  text-align: center;
}

.fail-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* 降级标识：整行横幅，比顶部孤立的小标签更容易被读到 */
.degraded-banner {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  text-align: center;
  font-size: var(--t-cap);
  border-radius: var(--r-md);
  margin-bottom: 20rpx;
}

/* ---------- 结果头部 ---------- */
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.disease-name {
  flex: 1;
  font-size: var(--t-h1);
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.2rpx;
  color: var(--ink);
}

.confidence {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 8rpx 20rpx;
  font-size: var(--t-micro);
  font-weight: 600;
  color: var(--brand-strong);
  background: var(--brand-soft);
  border-radius: var(--r-pill);
}

.result-meta {
  margin-top: 12rpx;
  font-size: var(--t-cap);
  line-height: 1.6;
  color: var(--ink-3);
}

.symptom {
  margin-top: 20rpx;
  font-size: var(--t-sm);
  line-height: 1.75;
  color: var(--ink-2);
}

.latency {
  margin-top: 16rpx;
  font-size: var(--t-micro);
  color: var(--ink-4);
}

/* ---------- 对照自查 ---------- */
.check-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: var(--t-sm);
  line-height: 1.65;
  color: var(--ink-2);
}

.check-item::before {
  content: "✓";
  flex: 0 0 auto;
  margin-right: 16rpx;
  font-size: var(--t-sm);
  font-weight: 700;
  color: var(--brand);
}

.check-txt {
  flex: 1;
}

/* ---------- 易混淆项 ---------- */
.confused-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.confused-item:last-child {
  border-bottom: none;
}

.confused-name {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6rpx;
}

/* ---------- 提示条内的项目符号跟随所在面板色调 ---------- */
.guide .bullet,
.safety-note .bullet {
  color: inherit;
}

.guide .bullet::before {
  background: var(--info);
}

.safety-note .bullet::before {
  background: var(--amber);
}

/* ---------- 操作区 ---------- */
.action-btn {
  width: 100%;
}

.retake-btn {
  width: 100%;
  margin-top: 20rpx;
}

/* ---------- 免责声明 ---------- */
.disclaimer {
  padding: 16rpx 16rpx 48rpx;
  text-align: center;
  font-size: var(--t-micro);
  line-height: 1.7;
  color: var(--ink-4);
  transition: opacity 160ms ease;
}
