/* 诊断历史：一份可下拉刷新的清单，行与行之间只用发丝线分隔 */

.list-card {
  padding: 8rpx 32rpx;
}

.record {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
  transition: transform 160ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 160ms ease;
}

.record:last-child {
  border-bottom: none;
}

/* 缩略图槽位固定占位，无图时留一块浅色方块，行与行左边界始终对齐 */
.thumb {
  flex: 0 0 auto;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-md);
  background: var(--brand-tint);
  overflow: hidden;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.record-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  overflow: hidden;
}

.record-title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-meta {
  margin-top: 8rpx;
  font-size: var(--t-cap);
  color: var(--ink-3);
  line-height: 1.5;
}

.arrow {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: var(--ink-4);
  font-size: 36rpx;
  line-height: 1;
}

/* 触底加载：小转圈 + 文案居中，替掉纯文字 */
.load-more {
  text-align: center;
  padding: 28rpx 0;
  font-size: var(--t-cap);
  color: var(--ink-4);
}

.back-btn {
  width: 400rpx;
  margin: 40rpx auto 0;
}
